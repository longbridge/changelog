---
import { formatDate, majorPath, t, type Locale } from '@lib/i18n'
import { majorSlugOf, type MajorGroup } from '@lib/majors'

interface Props {
  locale: Locale
  group: MajorGroup
  /** 多产品混排的首页要标出是哪个产品，产品页里不必重复 */
  showProduct?: boolean
  /** 头条位：整行占满，有配图就排在右边 */
  featured?: boolean
}

const { locale, group, showProduct, featured } = Astro.props
const product = group.product
const slug = majorSlugOf(group.entry)
const { title, summary, highlights = [], cover, coverAlt, status } = group.entry.data
const href = majorPath(locale, product.id, slug)
// The chip shows the newest version, the one readers see in the app; the footer lists the
// older versions folded into the same page, with a long tail collapsing into "+N"
const VERSION_LIMIT = 4
const [latest, ...older] = group.releases.map((release) => release.data.version)
const shownVersions = older.slice(0, VERSION_LIMIT)
const hiddenVersions = older.length - shownVersions.length
---

<article
  class:list={['major-card', 'accent-scope', featured && 'major-card--featured']}
  style={`--accent-default:${product.accent}`}
>
  <div class="major-card__text">
    {/* Eyebrow: which product and which major version, then when. Readers scan this line first */}
    <p class="major-card__eyebrow">
      {
        showProduct && (
          <span class="major-card__product">
            <img src={product.logo} alt="" width="16" height="16" loading="lazy" decoding="async" />
            {product.name[locale]}
          </span>
        )
      }
      <span class="version-chip tnum">v{latest}</span>
      <time class="major-card__date tnum" datetime={group.releasedAt.toISOString()}>
        {formatDate(group.releasedAt, locale)}
      </time>
    </p>

    <h2 class:list={['major-card__title', featured ? 'major-card__title--lg' : '']}>
      <a href={href} class="after:absolute after:inset-0">
        {title}
      </a>
    </h2>

    {summary && <p class="major-card__summary">{summary}</p>}

    {/* 头条有地方铺开，把亮点也列出来；网格里的卡片只留摘要，免得两列长短不一 */}
    {
      featured && highlights.length > 0 && (
        <ul class="major-card__highlights">
          {highlights.slice(0, 4).map((highlight) => (
            <li>
              <span class="major-card__dot" aria-hidden="true" />
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      (shownVersions.length > 0 || status === 'draft') && (
        <p class="major-card__meta">
          {shownVersions.length > 0 && (
            <span class="major-card__versions tnum">
              <span>{t.alsoIncludes[locale]}</span>
              {shownVersions.map((version) => <span>v{version}</span>)}
              {hiddenVersions > 0 && <span>+{hiddenVersions}</span>}
            </span>
          )}
          {status === 'draft' && (
            <span class="draft-badge rounded-md border px-1.5 py-0.5 text-[0.75rem]">
              {t.draftBadge[locale]}
            </span>
          )}
        </p>
      )
    }
  </div>

  {
    featured && cover && (
      <div class="major-card__cover">
        <img src={cover} alt={coverAlt ?? ''} loading="eager" decoding="async" />
      </div>
    )
  }
</article>
