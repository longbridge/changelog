---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import Meta from '@components/Meta.astro'
import Callout from '@components/Callout.astro'
import Figure from '@components/release/Figure.astro'
import Video from '@components/release/Video.astro'
import Compare from '@components/release/Compare.astro'
import Steps from '@components/release/Steps.astro'
import Step from '@components/release/Step.astro'
import Demo from '@components/release/Demo.astro'
import Kbd from '@components/release/Kbd.astro'
import LinkPreview from '@components/release/LinkPreview.astro'
import { LOCALES, localePath, majorSegment, previewPath, t, type Locale } from '@lib/i18n'
import { getProduct, homepageUrl, majorOf } from '@config/products.config'
import { listPreviews, slugOf, type Release } from '@lib/releases'

/** Same map as the major page, so preview MDX renders the same here */
const mdxComponents = { Callout, Figure, Video, Compare, Steps, Step, Demo, Kbd, LinkPreview, a: LinkPreview }

/**
 * Every preview gets a page of its own so its URL works from the day it ships.
 * Lists and major pages never show previews; the home page links to the newest one.
 */
export const getStaticPaths = (async () => {
  const byLocale = new Map<Locale, Release[]>()
  for (const locale of LOCALES) byLocale.set(locale, await listPreviews(locale))

  return LOCALES.flatMap((locale) =>
    (byLocale.get(locale) ?? []).map((release) => {
      const slug = slugOf(release)
      const major = majorOf(release.data.version)
      return {
        params: { locale, product: release.data.product, major: majorSegment(major), tag: slug },
        props: {
          release,
          // The language switcher goes to the same preview where it exists, otherwise the product page
          alternates: Object.fromEntries(
            LOCALES.map((item) => [
              item,
              (byLocale.get(item) ?? []).some(
                (candidate) =>
                  candidate.data.product === release.data.product && slugOf(candidate) === slug,
              )
                ? previewPath(item, release.data.product, major, slug)
                : localePath(item, release.data.product),
            ]),
          ),
        },
      }
    }),
  )
}) satisfies GetStaticPaths

const locale = Astro.params.locale as Locale
const { release, alternates } = Astro.props as {
  release: Release
  alternates: Partial<Record<Locale, string>>
}
const product = getProduct(release.data.product)
const productName = product?.name[locale] ?? release.data.product
const { Content } = await render(release)
const previewDownloads = product?.previewDownloads
const manifestUrl = previewDownloads?.manifest.replace('{version}', release.data.version)
---

<BaseLayout
  locale={locale}
  title={`${productName} ${release.data.version} · ${release.data.title}`}
  description={release.data.summary || product?.summary[locale]}
  alternates={alternates}
  accent={product?.accent}
  activeProduct={release.data.product}
  noindex
  breadcrumbs={[
    { name: t.allProducts[locale], path: localePath(locale) },
    { name: productName, path: localePath(locale, release.data.product) },
    { name: release.data.title },
  ]}
>
  <div class="mb-4 flex items-center justify-between gap-4">
    <a
      href={localePath(locale, release.data.product)}
      class="inline-block text-[0.8125rem] text-ink-soft transition-colors hover:text-ink"
      >← {productName}</a
    >
    {
      previewDownloads ? (
        <div
          class="preview-download"
          hidden
          data-manifest={manifestUrl}
          data-packages={JSON.stringify(previewDownloads.packages)}
        >
          <a
            href="#"
            data-preview-download
            class="inline-flex shrink-0 items-center gap-1.5 rounded-l-lg px-3 py-1.5 text-[0.8125rem] font-medium text-white transition-opacity hover:opacity-90"
            style="background:var(--accent)"
          >
            {t.downloadPreview[locale]}
          </a>
          <details class="preview-download__more">
            <summary
              class="inline-flex cursor-pointer list-none items-center rounded-r-lg border-l border-white/40 px-2 py-1.5 text-[0.8125rem] text-white"
              style="background:var(--accent)"
              aria-label={t.otherPackages[locale]}
              title={t.otherPackages[locale]}>▾</summary
            >
            <ul class="preview-download__list" data-preview-list />
          </details>
        </div>
      ) : (
        product?.homepage && (
          <a
            href={homepageUrl(product, locale)}
            class="inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-[0.8125rem] font-medium text-white transition-opacity hover:opacity-90"
            style="background:var(--accent)"
          >
            {t[product.homepageAction ?? 'download'][locale]}
            <span aria-hidden="true">↗</span>
          </a>
        )
      )
    }
  </div>

  <article id={slugOf(release)}>
    <h1 class="text-[1.75rem] leading-tight font-semibold tracking-tight sm:text-[2rem]">
      {release.data.title}
    </h1>
    <div class="mt-3">
      <Meta
        locale={locale}
        version={release.data.version}
        releasedAt={release.data.releasedAt}
        isDraft={release.data.status === 'draft'}
        draftLabel={t.draftBadge[locale]}
        prereleaseLabel={t.prereleaseBadge[locale]}
      />
    </div>
    {
      release.data.summary && (
        <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-soft">{release.data.summary}</p>
      )
    }
    <div class="prose mt-8">
      <Content components={mdxComponents} />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .preview-download {
    position: relative;
    display: inline-flex;
  }
  .preview-download[hidden] {
    display: none;
  }
  .preview-download__more summary::-webkit-details-marker {
    display: none;
  }
  .preview-download__list {
    position: absolute;
    right: 0;
    z-index: 10;
    margin-top: 0.375rem;
    min-width: 12rem;
    padding: 0.375rem;
    border: 1px solid var(--color-rule, #e5e5e5);
    border-radius: 0.75rem;
    background: var(--color-paper, #fff);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
  }
  .preview-download__list a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .preview-download__list a:hover {
    background: rgb(0 0 0 / 0.05);
  }
</style>

<script>
  // The installers' file names carry a build hash, so the real links come from the release
  // manifest on the CDN. The button stays hidden until it resolves, never pointing at a guess.
  type Asset = { name: string; url: string }
  type Pkg = { os: string; arch?: string; label: string; suffix: string }

  async function initPreviewDownload() {
    const box = document.querySelector<HTMLElement>('.preview-download')
    if (!box || box.dataset.bound) return
    box.dataset.bound = '1'

    let assets: Asset[]
    try {
      const res = await fetch(box.dataset.manifest!)
      if (!res.ok) return
      assets = (await res.json()).assets ?? []
    } catch {
      return
    }

    const packages: Pkg[] = JSON.parse(box.dataset.packages ?? '[]')
    const resolved = packages
      .map((pkg) => ({ pkg, asset: assets.find((a) => a.name.endsWith(pkg.suffix)) }))
      .filter((item): item is { pkg: Pkg; asset: Asset } => !!item.asset)
    if (resolved.length === 0) return

    const list = box.querySelector('[data-preview-list]')!
    for (const { pkg, asset } of resolved) {
      const li = document.createElement('li')
      const a = document.createElement('a')
      a.href = asset.url
      a.textContent = pkg.label
      a.setAttribute('download', '')
      li.append(a)
      list.append(li)
    }

    const main = box.querySelector<HTMLAnchorElement>('[data-preview-download]')!
    const pick = (os: string | undefined, arch?: string) =>
      resolved.find((item) => item.pkg.os === os && (!arch || item.pkg.arch === arch)) ??
      resolved.find((item) => item.pkg.os === os)

    const ua = navigator.userAgent
    let os: string | undefined
    if (/Android|iPhone|iPad|iPod/i.test(ua)) os = undefined
    else if (/Windows/i.test(ua)) os = 'windows'
    else if (/Mac/i.test(ua)) os = 'macos'
    else if (/Linux|X11/i.test(ua)) os = 'linux'

    // Phones and unknown systems get macOS ARM, or the first package, as the default
    const set = (item?: { asset: Asset }) => {
      if (!item) return
      main.href = item.asset.url
      main.setAttribute('download', '')
    }
    set(pick(os, os === 'macos' ? 'arm' : undefined) ?? pick('macos', 'arm') ?? resolved[0])
    box.hidden = false

    // Chromium can tell Intel from Apple Silicon; Safari always reports Intel, so ARM stays the default there
    if (os === 'macos') {
      const uaData = (navigator as any).userAgentData
      uaData?.getHighEntropyValues?.(['architecture'])
        .then((v: { architecture?: string }) => {
          if (v.architecture === 'x86') set(pick('macos', 'x64'))
        })
        .catch(() => {})
    }
  }
  document.addEventListener('astro:page-load', initPreviewDownload)
</script>
