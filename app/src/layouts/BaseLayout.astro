---
import { LOCALE_META, LOCALES, hreflangsOf, localePath, ogLocale, t, type Locale } from '@lib/i18n'
import { siteConfig } from '@config/site.config'
import JsonLd from '@components/JsonLd.astro'
import LocaleSwitcher from '@components/LocaleSwitcher.astro'
import { ClientRouter } from 'astro:transitions'
import Reveal from '@components/release/Reveal.astro'
import '../styles/global.css'

interface Props {
  locale: Locale
  title: string
  description?: string
  /** 各语言下对应的同一页面路径，用于 hreflang */
  alternates?: Partial<Record<Locale, string>>
  /** 产品主题色，注入后页面内的强调元素统一取色 */
  accent?: string
  /** 内部页面，不希望被搜索引擎收录 */
  noindex?: boolean
  /** 当前所在的产品，导航里高亮 */
  activeProduct?: string
  /** 结构化数据里的面包屑 */
  breadcrumbs?: { name: string; path?: string }[]
  /**
   * The title already names the product and version: don't append the site name. Keeps release
   * pages within what search results show (the brand is already at the start)
   */
  fullTitle?: boolean
  /** Share image (absolute URL). Shown as a large card; without it the square brand mark is used */
  ogImage?: string
  /** Release pages: published as an Article with dates, for search results and freshness */
  article?: {
    /** First release in this page */
    publishedTime: Date
    /** Latest release in this page */
    modifiedTime: Date
    /** What the article is about, e.g. the product name */
    about?: string
  }
}

const { locale, title, description, alternates, accent, noindex, activeProduct, breadcrumbs, fullTitle, ogImage, article } =
  Astro.props
const meta = LOCALE_META[locale]
const pageTitle =
  fullTitle || title === siteConfig.name[locale] ? title : `${title} · ${siteConfig.name[locale]}`
const pageDescription = description || siteConfig.description[locale]
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
/** 顶栏的站外入口，顺序即展示顺序。arrow 标记要不要带「离开本站」的小箭头 */
const externalLinks = [
  { href: siteConfig.helpCenter(locale), label: t.helpCenter[locale], arrow: false },
  { href: siteConfig.developers(locale), label: t.developers[locale], arrow: true },
]
---

<!doctype html>
<html
  lang={meta.htmlLang}
  data-rail="open"
  style={accent ? `--accent-default:${accent}` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={siteConfig.logo} />
    <link rel="apple-touch-icon" href={siteConfig.logo} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* 顶栏 logo 与 favicon 所在的 CDN，先把连接建起来 */}
    {
      siteConfig.preconnect.map((origin) => (
        <>
          <link rel="preconnect" href={origin} crossorigin="anonymous" />
          <link rel="dns-prefetch" href={origin} />
        </>
      ))
    }

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name[locale]} />
    <meta property="og:image" content={ogImage ?? siteConfig.logo} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {
      LOCALES.filter((alt) => alt !== locale).map((alt) => (
        <meta property="og:locale:alternate" content={ogLocale(alt)} />
      ))
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      LOCALES.flatMap((alt) =>
        alternates?.[alt]
          ? hreflangsOf(alt).map((tag) => (
              <link rel="alternate" hreflang={tag} href={new URL(alternates[alt]!, Astro.site ?? Astro.url.origin)} />
            ))
          : [],
      )
    }
    {/* Visitors whose language and region match none of the above get the English page */}
    {
      alternates?.en && (
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site ?? Astro.url.origin)} />
      )
    }
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name[locale]} href={localePath(locale, 'rss.xml')} />
    <link rel="alternate" type="application/feed+json" title={siteConfig.name[locale]} href={localePath(locale, 'rss.json')} />
    <JsonLd
      locale={locale}
      breadcrumbs={breadcrumbs}
      article={article && {
        ...article,
        headline: title,
        description: pageDescription,
        url: canonical.href,
        image: ogImage,
      }}
    />

    {/* 客户端路由：页面间淡入淡出，导航栏保持不动 */}
    <ClientRouter />
    <script>
      // 在别名域名（如 longbridge.cn）上打开时，把指向主站的链接换成当前域名，见 siteConfig.domainAliases。
      // 链接预览读的是 data-preview-src，一起换，换完与当前页同源才能内嵌预览
      import { siteConfig } from '@config/site.config'

      const aliases = siteConfig.domainAliases[location.hostname.replace(/^www\./, '')]

      function localizeLinks() {
        if (!aliases) return
        for (const element of document.querySelectorAll('a[href^="https://"], [data-preview-src^="https://"]')) {
          for (const attribute of ['href', 'data-preview-src']) {
            const value = element.getAttribute(attribute)
            if (!value) continue
            try {
              const url = new URL(value)
              const host = aliases[url.hostname]
              if (!host) continue
              url.hostname = host
              element.setAttribute(attribute, url.toString())
            } catch {}
          }
        }
      }

      document.addEventListener('astro:page-load', localizeLinks)
    </script>
    <script>
      const BASE = import.meta.env.BASE_URL.replace(/\/$/, '')

      /** 路径去掉 base 后还剩四段（locale / changelog / product / major）的才是详情页 */
      function isDetail(url: string | URL) {
        const path = new URL(url, location.origin).pathname
        const rest = path.startsWith(BASE) ? path.slice(BASE.length) : path
        return rest.split('/').filter(Boolean).length >= 4
      }

      /**
       * Back link from a detail page to a list: land on the card the reader came from instead of
       * the top of the list. after-swap still runs inside startViewTransition, so the scroll is
       * part of the new snapshot and the page fades in already in place, without a visible jump.
       * Browser back restores the list's scroll position by itself.
       */
      document.addEventListener('astro:before-preparation', (event) => {
        const { from, to, sourceElement } = event as unknown as {
          from: URL
          to: URL
          sourceElement?: Element
        }
        if (!isDetail(from) || isDetail(to) || !sourceElement?.closest('[data-back-to-list]')) return

        const detailPath = from.pathname.replace(/\/+$/, '')
        document.addEventListener(
          'astro:after-swap',
          () => {
            const link =
              document.querySelector(`.major-card a[href="${detailPath}"]`) ??
              document.querySelector(`.major-card a[href="${detailPath}/"]`)
            link?.closest('.major-card')?.scrollIntoView({ block: 'center', behavior: 'instant' })
          },
          { once: true },
        )
      })

      /**
       * 换页进度条。延迟一会儿才出现：预取命中时换页是瞬间的，进度条一闪反而像出了问题。
       * 进度是假的——fetch 拿不到可信的总长度，只表达「在加载」，完成时补满再淡出。
       */
      let progressTimer = 0
      const progress = () => document.querySelector<HTMLElement>('.nav-progress')

      document.addEventListener('astro:before-preparation', () => {
        clearTimeout(progressTimer)
        progressTimer = window.setTimeout(() => {
          const bar = progress()
          if (bar) bar.dataset.state = 'loading'
        }, 120)
      })

      document.addEventListener('astro:after-swap', () => {
        clearTimeout(progressTimer)
        const bar = progress()
        if (bar?.dataset.state !== 'loading') return
        bar.dataset.state = 'done'
        bar.addEventListener('transitionend', () => delete bar.dataset.state, { once: true })
        // 减弱动效下没有 transition，transitionend 不会来
        setTimeout(() => delete bar.dataset.state, 600)
      })

      document.addEventListener('astro:page-load', () => {
        // 记下读者停在哪个列表页：详情页的返回链接照这个走，
        // 从「全部产品」点进去的就退回「全部产品」，而不是那个产品的列表
        if (!isDetail(location.href)) {
          try {
            sessionStorage.setItem('lb:list', location.pathname)
          } catch {}
        }
      })
    </script>
    {/* 版本栏默认展开，只有用户手动收起过才记成 closed；状态放在 html 上，首屏即正确。
        换页后 html 会被替换，需要重新应用 */}
    <script is:inline>
      (() => {
        const apply = () => {
          document.documentElement.dataset.rail =
            localStorage.getItem('version-rail') === 'closed' ? 'closed' : 'open'
        }
        apply()
        if (!window.__railBound) {
          window.__railBound = true
          document.addEventListener('astro:after-swap', apply)
        }
      })()
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    {/* 换页进度条：ClientRouter 先 fetch 完下一页才切换，等待期间浏览器没有任何加载提示，
        回源慢的时候点了像没反应。persist 让它跨页保留，结束动画才走得完 */}
    <div class="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>
    <header
      class="site-header sticky top-0 z-20 border-b border-rule/70 bg-paper/85 backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-8 px-5 sm:h-14 sm:flex-nowrap">
        {/* 品牌位回主站，站内首页交给旁边的「全部更新日志」 */}
        {/* Same sizes as the main site's header logo: 88px wide on phones, 145px from tablet up */}
        <a href={siteConfig.brandUrl} class="flex h-14 shrink-0 items-center sm:h-auto">
          <img
            src={siteConfig.wordmark.src}
            alt={siteConfig.brand}
            width={siteConfig.wordmark.width}
            height={siteConfig.wordmark.height}
            class="h-auto w-[88px] md:w-[145px]"
            fetchpriority="high"
          />
        </a>

        {/* 产品直接铺开：一共就这么几个，藏进下拉反而多一次点击 */}
        {/* Same style as the main site's header nav. Always shown: on phones it drops to its own row under the lockup */}
        <nav class="site-nav order-last -mx-3 flex w-[calc(100%+1.5rem)] min-w-0 items-center gap-1 pb-1.5 sm:order-none sm:mx-0 sm:w-auto sm:pb-0" aria-label={t.allProducts[locale]}>
          <a
            href={localePath(locale)}
            aria-current={activeProduct ? undefined : 'page'}
            class="site-nav-link"
          >
            {t.allReleaseNotes[locale]}
          </a>
          {/* 站外链接：带个小箭头，读者知道点了会离开更新日志 */}
          {externalLinks.map(({ href, label, arrow }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener"
              class="site-nav-link"
            >
              {label}
              {arrow && (
                <svg aria-hidden="true" viewBox="0 0 12 12" class="h-2.5 w-2.5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2h6v6M10 2 3 9" /></svg>
              )}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex shrink-0 items-center gap-1.5">
          <LocaleSwitcher locale={locale} alternates={alternates} />
        </div>
      </div>
    </header>

    <Reveal locale={locale} />

    <main
      class="mx-auto w-full max-w-5xl flex-1 px-5 py-10 sm:py-14"
    >
      <slot />
    </main>

    <footer class="mt-16 border-t border-rule/70">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-4 gap-y-2 px-5 py-8 text-[0.8125rem] text-ink-faint"
      >
        <span>© {new Date().getFullYear()} Longbridge</span>
        <span class="text-rule" aria-hidden="true">|</span>
        {/* 主站入口：与顶栏的开发者平台一样新开标签页，读者看完还在更新日志 */}
        {
          siteConfig.footerLinks(locale).map((item) => (
            <a href={item.href} target="_blank" rel="noopener" class="transition-colors hover:text-ink">
              {t[item.key][locale]}
            </a>
          ))
        }
        <a
          href={localePath(locale, 'rss.xml')}
          class="transition-colors hover:text-ink">RSS</a
        >
      </div>
    </footer>
  </body>
</html>
